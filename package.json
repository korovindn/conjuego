{
  "name": "conjuego",
  "version": "1.0.0",
  "description": "Spanish verb conjugator. Tiny, typed, rule-based.",
  "license": "ISC",
  "author": "Dmitry Korovin <korovindn@proton.me>",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./por-defecto": {
      "import": "./dist/por-defecto.mjs",
      "require": "./dist/por-defecto.cjs"
    },
    "./dict/por_defecto.json": "./dict/por_defecto.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/por-defecto.*"
  ],
  "scripts": {
    "build": "vp pack",
    "build:dict": "node scripts/build-dict.js && vp fmt",
    "check": "vp check",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  },
  "files": [
    "dist",
    "dict"
  ]
}
